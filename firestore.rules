rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/admin {
      allow read, write: if true;
    }
    match /settings/org {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /join_requests/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
